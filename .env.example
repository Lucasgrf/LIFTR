# Variáveis SOMENTE do backend (Edge Functions / evals). Nunca no app Flutter (AGENTS.md, regra 7).
# Copie para .env (ignorado pelo git) e preencha.

SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=

# LLM (ADR-003)
GEMINI_API_KEY=

# WhatsApp via Evolution API (ADR-002)
EVOLUTION_API_URL=http://127.0.0.1:8080
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=
# Token esperado no header x-webhook-token das chamadas do webhook
WHATSAPP_WEBHOOK_TOKEN=

# Diretório com skills/ (runtime das Edge Functions); padrão: ./skills
SKILLS_DIR=./skills

